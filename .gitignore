# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Jupyter
.ipynb_checkpoints/

# ---------- Node / frontend ----------
node_modules/
frontend/dist/
frontend/dist-ssr/
.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- Data (never commit raw or derived data) ----------
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
*.db
*.sqlite
*.sqlite3
*.parquet

# ---------- Trained models ----------
*.pkl
*.joblib
*.model
models_output/

# ---------- Assets (binary images, fetched not committed) ----------
assets/logos/*
assets/players/*
!assets/logos/.gitkeep
!assets/players/.gitkeep

# ---------- Secrets ----------
.env
.env.*
!.env.example

# ---------- Editors ----------
.vscode/
.idea/
*.swp

# ---------- Windows / OneDrive ----------
Thumbs.db
desktop.ini
.DS_Store
